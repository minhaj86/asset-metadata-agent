# Copy to `.env` (never commit `.env`) and adjust.
# docker compose reads this file automatically; for `./mvnw spring-boot:run` export the variables
# in your shell, e.g. `set -a; source .env; set +a`.

# --- Database (docker compose + application) ---
DAM_DB_HOST=localhost
DAM_DB_PORT=5433
DAM_DB_NAME=dam
DAM_DB_USER=dam
DAM_DB_PASSWORD=dam

# --- Chat model provider: demo | openai | anthropic | ollama ---
# "demo" is a deterministic offline stand-in so the agentic workflow runs without any API key.
AI_PROVIDER=demo

# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (docker compose --profile ollama up -d && docker exec dam-metadata-ollama ollama pull llama3.1:8b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embedding model: local (in-process all-MiniLM-L6-v2, 384 dims) | openai | ollama ---
# Changing the provider usually changes the vector dimension: set AI_EMBEDDING_DIMENSION accordingly
# and start from an empty database (the dimension is baked into the Flyway migration).
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_DIMENSION=384
# AI_EMBEDDING_MODEL=text-embedding-3-small
